{
  "name": "tamias",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "dashboard",
    "api",
    "worker"
  ],
  "scripts": {
    "build": "bun run --workspaces --if-present build",
    "check:architecture": "bun run scripts/check-architecture.ts",
    "ci:affected": "bun run scripts/ci-affected.ts",
    "clean": "git clean -xdf node_modules",
    "clean:workspaces": "bun run --workspaces --if-present clean",
    "dev": "bun run dev:dashboard",
    "dev:fresh": "bash scripts/kill-dev-ports.sh && bun run dev",
    "dev:local": "bun run dev:dashboard",
    "deploy:cloudflare:documents:production": "wrangler deploy --config worker/documents.wrangler.jsonc --env=production",
    "deploy:cloudflare:production": "cd dashboard && bun run build:start && cd .. && bun run deploy:cloudflare:documents:production && wrangler deploy --config wrangler.jsonc --env=production",
    "preflight:cloudflare:documents:production": "wrangler deploy --dry-run --config worker/documents.wrangler.jsonc --env=production",
    "preflight:cloudflare:documents": "wrangler deploy --dry-run --config worker/documents.wrangler.jsonc",
    "preflight:cloudflare:production": "bun run preflight:cloudflare:documents:production && cd dashboard && bun run preflight:cf:production",
    "preflight:cloudflare": "bun run preflight:cloudflare:documents && cd dashboard && bun run preflight:cf",
    "test": "bun run --workspaces --parallel --if-present test",
    "test:e2e": "playwright test -c playwright.config.ts",
    "test:e2e:headed": "playwright test -c playwright.config.ts --headed",
    "start:dashboard": "bun run --filter @tamias/dashboard start",
    "dev:dashboard": "bun run --filter @tamias/dashboard dev",
    "build:dashboard": "bun run --filter @tamias/dashboard build",
    "backfill:derived-compliance-ledger": "bun --env-file=.env run scripts/backfill-derived-compliance-ledger.ts",
    "format": "prettier --write .",
    "git:doctor": "bun run scripts/git-doctor.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "bun run --workspaces --parallel --if-present typecheck"
  },
  "packageManager": "bun@1.3.11",
  "catalog": {
    "@ai-sdk/google": "^3.0.53",
    "@ai-sdk/mistral": "3.0.27",
    "@ai-sdk/openai": "3.0.48",
    "@ai-sdk/react": "3.0.143",
    "@ai-sdk/rsc": "2.0.141",
    "@date-fns/tz": "^1.4.1",
    "@fast-csv/format": "5.0.5",
    "@react-pdf/renderer": "^4.3.1",
    "@sindresorhus/slugify": "^3.0.0",
    "ai": "6.0.141",
    "camelcase-keys": "^10.0.1",
    "change-case": "^5.4.4",
    "date-fns": "^4.1.0",
    "hono": "4.12.18",
    "jose": "^6.1.3",
    "nanoid": "^5.1.6",
    "node-xlsx": "^0.24.0",
    "papaparse": "^5.5.3",
    "pino": "^10.1.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "typescript": "^6.0.2",
    "uuid": "^14.0.0",
    "zod": "^4.3.5"
  },
  "trustedDependencies": [
    "@depot/cli",
    "core-js",
    "protobufjs"
  ],
  "overrides": {
    "@fastify/static": "9.1.3",
    "@hono/node-server": "1.19.14",
    "@xmldom/xmldom": "0.8.13",
    "file-type": "22.0.1",
    "ip-address": "10.2.0",
    "lodash-es": "4.18.1",
    "postcss": "8.5.14"
  },
  "devDependencies": {
    "@eslint/js": "9",
    "@playwright/test": "^1.55.1",
    "eslint": "9",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "globals": "^17.4.0",
    "prettier": "^3.8.1",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.58.0"
  }
}
