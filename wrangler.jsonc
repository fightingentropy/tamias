{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // Single Cloudflare Worker for dashboard, API, and async runtime.
  "name": "tamias-local",
  "main": "./dashboard/dist/server/index.mjs",
  "compatibility_date": "2026-03-28",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dashboard/dist/client",
    "binding": "ASSETS",
  },
  "observability": {
    "enabled": true,
  },
  "images": {
    "binding": "IMAGES",
    "remote": true,
  },
  "r2_buckets": [
    {
      "binding": "VAULT_BUCKET",
      "bucket_name": "tamias-vault-local",
    },
  ],
  "d1_databases": [
    {
      "binding": "APP_DB",
      "database_name": "tamias-app-data-local",
      "database_id": "2eee43fb-12b9-4cfe-90b5-af95250d1062",
      "migrations_dir": "api/migrations/d1",
    },
  ],
  "send_email": [
    {
      "name": "EMAIL",
    },
  ],
  "services": [
    {
      "binding": "DOCUMENTS_WORKER",
      "service": "tamias-documents-local",
    },
  ],
  "triggers": {
    "crons": [
      "*/5 * * * *",
      "0 2 * * *",
      "0 3 * * *",
      "*/30 * * * *",
      "0 0,12 * * *",
      "*/30 * * * 1",
    ],
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "RATE_LIMIT_COORDINATOR",
        "class_name": "RateLimitCoordinator",
      },
      {
        "name": "RUN_COORDINATOR",
        "class_name": "RunCoordinator",
      },
    ],
  },
  "workflows": [
    {
      "binding": "ASYNC_WORKFLOW",
      "name": "tamias-workflow-local",
      "class_name": "AsyncWorkflow",
    },
  ],
  "queues": {
    "producers": [
      {
        "binding": "CAPTURE_QUEUE",
        "queue": "tamias-capture-local",
      },
      {
        "binding": "DOCUMENTS_QUEUE",
        "queue": "tamias-documents-local",
      },
      {
        "binding": "LEDGER_QUEUE",
        "queue": "tamias-ledger-local",
      },
      {
        "binding": "OUTBOX_QUEUE",
        "queue": "tamias-outbox-local",
      },
    ],
    "consumers": [
      {
        "queue": "tamias-capture-local",
        "max_batch_size": 10,
        "max_batch_timeout": 5,
        "max_retries": 3,
        "dead_letter_queue": "tamias-capture-dlq-local",
      },
      {
        "queue": "tamias-ledger-local",
        "max_batch_size": 10,
        "max_batch_timeout": 5,
        "max_retries": 3,
        "dead_letter_queue": "tamias-ledger-dlq-local",
      },
      {
        "queue": "tamias-outbox-local",
        "max_batch_size": 10,
        "max_batch_timeout": 5,
        "max_retries": 3,
        "dead_letter_queue": "tamias-outbox-dlq-local",
      },
      {
        "queue": "tamias-capture-dlq-local",
        "max_batch_size": 10,
        "max_batch_timeout": 5,
        "max_retries": 10,
      },
      {
        "queue": "tamias-ledger-dlq-local",
        "max_batch_size": 10,
        "max_batch_timeout": 5,
        "max_retries": 10,
      },
      {
        "queue": "tamias-outbox-dlq-local",
        "max_batch_size": 10,
        "max_batch_timeout": 5,
        "max_retries": 10,
      },
    ],
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["RateLimitCoordinator", "RunCoordinator"],
    },
  ],
  "vars": {
    "TAMIAS_ENVIRONMENT": "development",
    "DASHBOARD_URL": "http://127.0.0.1:8787",
    "WEBSITE_URL": "http://127.0.0.1:8787",
    "API_URL": "http://127.0.0.1:8787",
  },
  "env": {
    "production": {
      "name": "tamias",
      "routes": [
        { "pattern": "app.tamias.xyz", "custom_domain": true },
        { "pattern": "tamias.xyz", "custom_domain": true },
        { "pattern": "api.tamias.xyz", "custom_domain": true },
      ],
      "images": { "binding": "IMAGES", "remote": true },
      "send_email": [
        {
          "name": "EMAIL",
        },
      ],
      "services": [
        {
          "binding": "DOCUMENTS_WORKER",
          "service": "tamias-documents",
        },
      ],
      "triggers": {
        "crons": [
          "*/5 * * * *",
          "0 2 * * *",
          "0 3 * * *",
          "*/30 * * * *",
          "0 0,12 * * *",
          "*/30 * * * 1",
        ],
      },
      "durable_objects": {
        "bindings": [
          {
            "name": "RATE_LIMIT_COORDINATOR",
            "class_name": "RateLimitCoordinator",
          },
          {
            "name": "RUN_COORDINATOR",
            "class_name": "RunCoordinator",
          },
        ],
      },
      "workflows": [
        {
          "binding": "ASYNC_WORKFLOW",
          "name": "tamias-workflow",
          "class_name": "AsyncWorkflow",
        },
      ],
      "queues": {
        "producers": [
          {
            "binding": "CAPTURE_QUEUE",
            "queue": "tamias-capture",
          },
          {
            "binding": "DOCUMENTS_QUEUE",
            "queue": "tamias-documents",
          },
          {
            "binding": "LEDGER_QUEUE",
            "queue": "tamias-ledger",
          },
          {
            "binding": "OUTBOX_QUEUE",
            "queue": "tamias-outbox",
          },
        ],
        "consumers": [
          {
            "queue": "tamias-capture",
            "max_batch_size": 10,
            "max_batch_timeout": 5,
            "max_retries": 3,
            "dead_letter_queue": "tamias-capture-dlq",
          },
          {
            "queue": "tamias-ledger",
            "max_batch_size": 10,
            "max_batch_timeout": 5,
            "max_retries": 3,
            "dead_letter_queue": "tamias-ledger-dlq",
          },
          {
            "queue": "tamias-outbox",
            "max_batch_size": 10,
            "max_batch_timeout": 5,
            "max_retries": 3,
            "dead_letter_queue": "tamias-outbox-dlq",
          },
          {
            "queue": "tamias-capture-dlq",
            "max_batch_size": 10,
            "max_batch_timeout": 5,
            "max_retries": 10,
          },
          {
            "queue": "tamias-ledger-dlq",
            "max_batch_size": 10,
            "max_batch_timeout": 5,
            "max_retries": 10,
          },
          {
            "queue": "tamias-outbox-dlq",
            "max_batch_size": 10,
            "max_batch_timeout": 5,
            "max_retries": 10,
          },
        ],
      },
      "migrations": [
        { "tag": "v1", "new_sqlite_classes": ["RateLimitCoordinator", "RunCoordinator"] },
        { "tag": "v2", "deleted_classes": ["RateLimitCoordinator", "RunCoordinator"] },
        { "tag": "v3", "new_sqlite_classes": ["RateLimitCoordinator", "RunCoordinator"] },
      ],
      "vars": {
        "TAMIAS_ENVIRONMENT": "production",
        "DASHBOARD_URL": "https://app.tamias.xyz",
        "WEBSITE_URL": "https://tamias.xyz",
        "API_URL": "https://api.tamias.xyz",
        "TRUELAYER_CLIENT_ID": "sandbox-tamias-7a82d0",
        "TRUELAYER_ENVIRONMENT": "sandbox",
        "TRUELAYER_REDIRECT_URI": "https://api.tamias.xyz/apps/truelayer/oauth-callback",
      },
      "r2_buckets": [
        {
          "binding": "VAULT_BUCKET",
          "bucket_name": "tamias-vault",
        },
      ],
      "d1_databases": [
        {
          "binding": "APP_DB",
          "database_name": "tamias-app-data-production",
          "database_id": "04abc5e2-fed9-4811-9b74-e16c1e708b9a",
          "migrations_dir": "api/migrations/d1",
        },
      ],
    },
  },
}
